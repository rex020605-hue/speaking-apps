{
  "name": "mallo-speaking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && node scripts/build-preview.mjs",
    "start": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "npm run build:preview && playwright test",
    "test:pages": "npm run build -- --base=/speaking-apps/ && node scripts/check-pages.mjs",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
